    <ControlTemplate x:Key="TemplateWindow_AKN" TargetType="{x:Type Window}">
        <Grid>
            <Border
                Background="{StaticResource CorWhite}"
                BorderBrush="{DynamicResource CorCream}"
                BorderThickness="1"
                CornerRadius="8"
                SnapsToDevicePixels="True" />
            <StackPanel Style="{DynamicResource StyleStackPanelTitleBar}">
