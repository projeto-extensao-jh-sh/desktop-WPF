    <Style
        x:Key="StyleTextBoxWithPlaceHolderName"
        BasedOn="{StaticResource StyleTextBoxReadOnly}"
        TargetType="{x:Type TextBox}">
        <Setter Property="Height" Value="{StaticResource ControlsHeight}" />
        <Setter Property="IsReadOnly" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Border
                        x:Name="border"
                        Background="{StaticResource CorGrayLightMidle}"
                        BorderBrush="{StaticResource CorGrayLight}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="5">
                        <StackPanel Orientation="Horizontal">
                            <ScrollViewer
                                x:Name="PART_ContentHost"
                                Padding="{TemplateBinding Padding}"
                                VerticalAlignment="Center"
                                Focusable="false"
                                HorizontalScrollBarVisibility="Hidden"
                                VerticalScrollBarVisibility="Hidden" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="true">
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource CorGreenLight}" />
                        </Trigger>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource textPlaceHolderNome}" />
                        </Trigger>
                        <Trigger Property="Text" Value="{x:Null}">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource textPlaceHolderNome}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
