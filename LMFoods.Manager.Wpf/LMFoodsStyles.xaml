    <!--#region Style TextBoxWithPlaceHolder Nome-->
    <VisualBrush
        x:Key="textPlaceHolderNome"
        AlignmentX="Center"
        Stretch="None"
        TileMode="None">
        <VisualBrush.Visual>
            <TextBlock Foreground="{StaticResource CorGray}" Text="Insira o Parâmetro..." />
