<Application x:Class="LMFoods.Manager.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"             
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:local="clr-namespace:LMFoods.Manager.Wpf">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/LMFoodsStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>


            <Style x:Key="StyleWindow" TargetType="{x:Type Window}" BasedOn="{StaticResource StyleWindowXAML}">
                <EventSetter Event="MouseDown" Handler="Window_MouseDown"/>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>