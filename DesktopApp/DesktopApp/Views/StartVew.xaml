<Window x:Class="DesktopApp.Views.StartView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DesktopApp.Views"
        mc:Ignorable="d"        
        Title="WindowStart" Height="600" Width="950">
    
    <Grid>
        <TextBlock Text="Tipo de licença:" Width="82" Margin="117,497,0,21" HorizontalAlignment="Left" />
        <TextBlock Text="{Binding TextoLicencaTipo}" Width="auto" Margin="207,497,0,21" FontWeight="Bold" Foreground="{DynamicResource CorRed500}" HorizontalAlignment="Left" Background="Black"/>

        <TextBlock Text="Seu período de licença termina em:" Width="187" Margin="12,518,0,0" HorizontalAlignment="Left" />
        <TextBlock Text="{Binding LicencaDataExpiracao}" Width="auto" Margin="207,518,0,0" FontWeight="Bold" Foreground="{DynamicResource CorRed500}" HorizontalAlignment="Left"/>

        <Button Content="Cancelar" Command="{Binding CancelarCommand}" CommandParameter="{Binding ElementName=WindowStart}" Style="{StaticResource StyleButtonCancel}" HorizontalAlignment="Right" 
                ToolTip="Cancela e Finaliza o formulário de cópia com referência." Margin="0,500,132,0" Height="34" VerticalAlignment="Top"/>
        <Button x:Name="ButtonCopiar" Content="Copiar" Command="{Binding CopiarCommand}" CommandParameter="{Binding ElementName=WindowStart}"  Style="{StaticResource StyleButtonOk}" ToolTip="Inicia cópia com referência da estrutura acima" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,500,0,0" />
    </Grid>
</Window>
